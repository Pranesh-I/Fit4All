# SAI Sports Talent Assessment - Environment Configuration
# Copy this file to .env and fill in your values

# ── Application ────────────────────────────────────────────
APP_NAME="SAI Sports Talent Assessment"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# ── Database ───────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+asyncpg://sai_user:sai_password@localhost:5432/sai_sports_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# ── JWT ────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_SECURE_256_BIT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_TEMP_TOKEN_EXPIRE_MINUTES=10

# ── Face Verification ──────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.5
FACE_EMBEDDING_DIMENSION=128

# ── Firebase ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# ── Rate Limiting ──────────────────────────────────────────
OTP_RATE_LIMIT_PER_MINUTE=3
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ── CORS ───────────────────────────────────────────────────
# Comma-separated origins. Use * for development only.
ALLOWED_ORIGINS=["https://your-flutter-app.com"]

# ── Security ───────────────────────────────────────────────
HTTPS_ONLY=true
